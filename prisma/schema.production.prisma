generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks             Task[]
  agentInteractions AgentInteraction[]
  presentations     Presentation[]
}

model TaskOrigin {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String   @default("#6B7280")
  icon        String   @default("ðŸ“Œ")
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks Task[]
}

model Task {
  id           String    @id @default(cuid())
  title        String
  description  String?
  origin       String?
  originId     String?
  priority     String    @default("MEDIA")
  status       String    @default("PENDENTE")
  person       String?
  responsible  String?
  observations String?
  dueDate      DateTime?
  receivedAt   DateTime?
  inboxItemId  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  userId        String
  user          User                @relation(fields: [userId], references: [id])
  taskOrigin    TaskOrigin?         @relation(fields: [originId], references: [id])
  history       TaskHistory[]
  statusHistory TaskStatusHistory[]
  suggestions   AiSuggestion[]
  attachments   TaskAttachment[]
  chats         TaskChat[]
  inboxItem     InboxItem?          @relation(fields: [inboxItemId], references: [id])
}

model TaskChat {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  role      String
  content   String
  mode      String?
  createdAt DateTime @default(now())
}

model TaskAttachment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName  String
  fileType  String
  fileSize  Int
  filePath  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaskHistory {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  action      String
  description String
  oldValue    String?
  newValue    String?
  createdAt   DateTime @default(now())
}

model TaskStatusHistory {
  id             String   @id @default(cuid())
  taskId         String
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  statusAnterior String
  statusNovo     String
  observacao     String
  responsavel    String
  waitingFor     String?
  waitingReason  String?
  createdAt      DateTime @default(now())
}

// â”€â”€â”€ INBOX â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model InboxItem {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())

  // Origem: SIMULATED | OUTLOOK | GMAIL
  provider   String   @default("SIMULATED")

  // VÃ­nculo com conta de e-mail real (nullable â†’ dados simulados nÃ£o tÃªm)
  accountId  String?
  account    EmailAccount? @relation(fields: [accountId], references: [id])

  // ID externo Ãºnico do provedor (para deduplicaÃ§Ã£o)
  externalId String?

  // Pasta/label de origem
  folderId   String?
  folder     EmailFolder? @relation(fields: [folderId], references: [id])

  // Remetente
  sender      String
  senderEmail String?

  // ConteÃºdo
  subject     String
  bodyPreview String?
  body        String
  receivedAt  DateTime @default(now())

  // Flags
  isRead      Boolean  @default(false)
  isIgnored   Boolean  @default(false)
  taskCreated Boolean  @default(false)
  hasAttachments Boolean @default(false)

  // AnÃ¡lise IA
  summary              String?
  aiSuggestedTaskTitle String?
  aiSuggestedPriority  String?
  aiSuggestedDueDate   String?
  aiSuggestedResponse  String?

  // Campos legados â€” mantidos para dados simulados existentes
  suggestedTask  String?
  suggestedReply String?

  tasks Task[]

  @@unique([provider, externalId])
}

// â”€â”€â”€ EMAIL ACCOUNTS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model EmailAccount {
  id           String   @id @default(cuid())
  provider     String   // OUTLOOK | GMAIL
  email        String
  displayName  String?
  accessToken  String   // criptografado em produÃ§Ã£o
  refreshToken String?
  expiresAt    DateTime?
  connectedAt  DateTime @default(now())
  lastSyncAt   DateTime?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  folders    EmailFolder[]
  inboxItems InboxItem[]

  @@unique([provider, email])
}

model EmailFolder {
  id               String   @id @default(cuid())
  accountId        String
  account          EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  providerFolderId String
  name             String
  isSelected       Boolean  @default(false)
  totalCount       Int?
  unreadCount      Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  inboxItems InboxItem[]

  @@unique([accountId, providerFolderId])
}

// â”€â”€â”€ IA / AGENTES â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model AiSuggestion {
  id        String   @id @default(cuid())
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  agent     String
  content   String
  type      String
  createdAt DateTime @default(now())
}

model AgentInteraction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  agent     String
  role      String
  content   String
  createdAt DateTime @default(now())
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// â”€â”€â”€ ESPECIALISTAS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model EspecialistaConversation {
  id           String   @id @default(cuid())
  title        String
  specialist   String
  isFavorite   Boolean  @default(false)
  isArchived   Boolean  @default(false)
  messageCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  messages EspecialistaMessage[]
}

model EspecialistaMessage {
  id             String                   @id @default(cuid())
  conversationId String
  conversation   EspecialistaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  sources        String?
  specialist     String?
  docsUsed       String?  // JSON array of doc titles used in this response
  autoUpdated    Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model EspecialistaUpdateLog {
  id          String   @id @default(cuid())
  specialist  String
  version     String
  newDocs     Int      @default(0)
  updatedDocs Int      @default(0)
  removedDocs Int      @default(0)
  duration    Int      @default(0)   // milliseconds
  triggeredBy String   @default("manual") // manual | auto | scheduled
  status      String   @default("completed")
  createdAt   DateTime @default(now())

  @@index([specialist])
}

model EspecialistaBase {
  id              String    @id @default(cuid())
  specialist      String    @unique
  status          String    @default("DESATUALIZADO")
  lastUpdated     DateTime?
  version         String?
  docCount        Int       @default(0)
  lastChecked     DateTime?
  sources         String?
  docsByCategory  String?
  nextUpdate      DateTime?
  initialLoadDone Boolean   @default(false)
  initialLoadAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model EspecialistaDocument {
  id         String   @id @default(cuid())
  specialist String
  title      String
  category   String   @default("geral")
  type       String   @default("documento")
  content    String?
  source     String?
  version    String?
  tags       String?
  embedding  String?  // JSON float[] â€” text-embedding-3-small (1536d)
  checksum   String?  // SHA-256 do conteÃºdo para detectar alteraÃ§Ãµes
  isRevoked  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([specialist])
  @@index([specialist, isRevoked])
}

// MemÃ³ria contextual por especialista + usuÃ¡rio (curto, mÃ©dio e longo prazo)
model EspecialistaMemory {
  id             String   @id @default(cuid())
  specialist     String
  conversationId String?  // null = memÃ³ria global do especialista
  type           String   @default("topic") // topic | entity | preference | summary
  key            String
  value          String
  relevance      Float    @default(1.0)
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([specialist, conversationId])
  @@index([specialist, type])
}

// Fontes monitoradas por especialista (para atualizador inteligente)
model EspecialistaSource {
  id          String    @id @default(cuid())
  specialist  String
  label       String
  url         String
  description String?
  lastFetched DateTime?
  lastHash    String?   // hash do conteÃºdo para detectar mudanÃ§as
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([specialist, active])
}

// Log de execuÃ§Ãµes de ferramentas
model EspecialistaToolExecution {
  id             String   @id @default(cuid())
  specialist     String
  conversationId String?
  toolName       String
  input          String   // JSON
  output         String   // JSON
  duration       Int      @default(0)
  error          String?
  createdAt      DateTime @default(now())

  @@index([specialist, toolName])
}

model Notification {
  id          String   @id @default(cuid())
  type        String   // TASK_CREATED | TASK_URGENT | TASK_OVERDUE | TASK_WAITING | EMAIL_RECEIVED | AI_SUGGESTION
  title       String
  message     String
  relatedType String?  // task | inbox
  relatedId   String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// â”€â”€â”€ PROJETOS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  objective   String?
  responsible String?
  startDate   DateTime?
  dueDate     DateTime?
  priority    String   @default("MEDIA")   // BAIXA | MEDIA | ALTA | URGENTE
  status      String   @default("PLANEJADO") // PLANEJADO | EM_ANDAMENTO | PAUSADO | ATRASADO | CONCLUIDO | CANCELADO
  progress    Int      @default(0)          // 0-100 calculado
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stages     ProjectStage[]
  tasks      ProjectTask[]
  milestones ProjectMilestone[]
  history    ProjectHistory[]
}

model ProjectStage {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  order       Int      @default(0)
  startDate   DateTime?
  dueDate     DateTime?
  status      String   @default("NAO_INICIADA") // NAO_INICIADA | EM_ANDAMENTO | AGUARDANDO | CONCLUIDA | ATRASADA | CANCELADA
  progress    Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks ProjectTask[]
}

model ProjectTask {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stageId     String?
  stage       ProjectStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  title       String
  description String?
  responsible String?
  startDate   DateTime?
  dueDate     DateTime?
  status      String   @default("PENDENTE") // PENDENTE | EM_ANDAMENTO | AGUARDANDO_RETORNO | CONCLUIDA | CANCELADA | ATRASADA
  priority    String   @default("MEDIA")
  progress    Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectMilestone {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  dueDate      DateTime?
  completedAt  DateTime?
  status       String    @default("PENDENTE") // PENDENTE | CONCLUIDA | ATRASADA | CANCELADA
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ProjectHistory {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String   // CRIACAO | STATUS | PRAZO | ETAPA_CRIADA | ETAPA_CONCLUIDA | TAREFA_CRIADA | TAREFA_CONCLUIDA | MARCO_CRIADO | MARCO_CUMPRIDO | EDICAO | IA_ANALISE
  title       String
  description String?
  createdAt   DateTime @default(now())
}

// â”€â”€â”€ CONFERÃŠNCIA â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Conference {
  id                 String    @id @default(cuid())
  title              String
  processType        String    // FOLHA | RESCISAO | FERIAS | ADMISSAO | BENEFICIOS | ENCARGOS | PAGAMENTO | MOVIMENTACAO | PONTO | ESOCIAL | FGTS | IRRF | DCTFWEB | OUTROS
  competence         String?   // ex: "06/2026"
  companyUnit        String?
  analystName        String?
  coordinatorName    String?
  conferenceDate     DateTime?
  correctionDueDate  DateTime?
  status             String    @default("PENDENTE") // PENDENTE | EM_CONFERENCIA | COM_INCONSISTENCIA | AGUARDANDO_CORRECAO | CORRIGIDO | APROVADO | REPROVADO | CANCELADO
  priority           String    @default("MEDIA")    // BAIXA | MEDIA | ALTA | URGENTE
  description        String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  checklist   ConferenceChecklistItem[]
  issues      ConferenceIssue[]
  corrections ConferenceCorrection[]
  analyses    ConferenceAiAnalysis[]
  history     ConferenceHistory[]
  chats       ConferenceChat[]
}

model ConferenceChecklistItem {
  id                   String    @id @default(cuid())
  conferenceId         String
  conference           Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  description          String
  result               String    @default("PENDENTE_ANALISE") // CONFORME | NAO_CONFORME | NAO_APLICA | PENDENTE_ANALISE
  notes                String?
  correctionResponsible String?
  correctionDueDate    DateTime?
  order                Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model ConferenceIssue {
  id                    String    @id @default(cuid())
  conferenceId          String
  conference            Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  title                 String
  description           String?
  severity              String    @default("MEDIA")  // BAIXA | MEDIA | ALTA | CRITICA
  impact                String?
  probableCause         String?
  recommendedSolution   String?
  correctionResponsible String?
  correctionDueDate     DateTime?
  correctionStatus      String    @default("ABERTA") // ABERTA | EM_CORRECAO | CORRIGIDA | VALIDADA | CANCELADA
  finalNotes            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  corrections ConferenceCorrection[]
}

model ConferenceCorrection {
  id           String    @id @default(cuid())
  conferenceId String
  conference   Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  issueId      String?
  issue        ConferenceIssue? @relation(fields: [issueId], references: [id], onDelete: SetNull)
  responsible  String?
  dueDate      DateTime?
  status       String    @default("ABERTA") // ABERTA | EM_CORRECAO | CORRIGIDA | VALIDADA | CANCELADA
  notes        String?
  correctedAt  DateTime?
  validatedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ConferenceAiAnalysis {
  id           String    @id @default(cuid())
  conferenceId String
  conference   Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  analysisType String    // COMPLETA | TEXTO_CORRECAO | ORIENTACAO_ANALISTA | PARECER_FINAL | PLANO_PREVENCAO | CHECKLIST_SUGERIDO
  content      String
  aiPowered    Boolean   @default(false)
  createdAt    DateTime  @default(now())
}

model ConferenceChat {
  id           String    @id @default(cuid())
  conferenceId String
  conference   Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  role         String    // user | assistant
  content      String
  mode         String?
  createdAt    DateTime  @default(now())
}

model ConferenceHistory {
  id           String    @id @default(cuid())
  conferenceId String
  conference   Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  type         String    // CRIACAO | STATUS | ITEM_CONFERIDO | INCONSISTENCIA | IA_ANALISE | CORRECAO_SOLICITADA | CORRECAO_REALIZADA | APROVADA | REPROVADA | EDICAO
  title        String
  description  String?
  createdAt    DateTime  @default(now())
}

// â”€â”€â”€ GESTÃƒO DE EQUIPE â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model TeamMember {
  id           String    @id @default(cuid())
  name         String
  role         String
  sector       String?
  unit         String?
  email        String?
  phone        String?
  joinedAt     DateTime?
  status       String    @default("ATIVO") // ATIVO | AFASTADO | FERIAS | INATIVO
  observations String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  feedbacks           TeamFeedback[]
  directions          TeamActivityDirection[]
  vacations           TeamVacation[]
  trainings           TeamTraining[]
  trainingParticipations TrainingParticipant[]
  activities          TeamActivity[]
  history             TeamHistory[]
  memberActivityLinks MemberActivityLink[]
  companyLinks        MemberCompanyLink[]
  salary              MemberSalary?
  hourBankEntries     HourBankEntry[]
  hourBankConfig      HourBankConfig?
  schedules              EmployeeSchedule[]
  dailyTimeRecords       DailyTimeRecord[]
  monthlyTimeCompetences MonthlyTimeCompetence[]
  calendarExceptions     MemberCalendarException[]
}

// â”€â”€â”€ CARTEIRA DE EMPRESAS E REMUNERAÃ‡ÃƒO â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model ClientCompany {
  id             String   @id @default(cuid())
  name           String
  cnpj           String?
  segment        String?
  observations   String?
  active         Boolean  @default(true)
  ibgeCode         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberLinks MemberCompanyLink[]

  @@index([active])
  snapshots      CompanyOperationalSnapshot[]
  systems        CompanySystem[]
  processConfigs CompanyProcessConfig[]
}

model MemberCompanyLink {
  id                   String        @id @default(cuid())
  memberId             String
  member               TeamMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  companyId            String
  company              ClientCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)
  // Papel do colaborador nesta empresa
  memberRole           String?       // RESPONSAVEL | APOIO | CONFERENCIA | APROVACAO | ADMISSAO | PONTO | FOLHA | FERIAS | RESCISAO | BENEFICIOS | ENCARGOS | ATENDIMENTO | OUTRO
  // Headcount
  headcountActive      Int?          // empregados ativos
  headcountApprentice  Int?          // aprendizes
  headcountIntern      Int?          // estagiÃ¡rios
  headcountOnLeave     Int?          // afastados
  headcountUpdatedAt   DateTime?     // data da atualizaÃ§Ã£o do headcount
  // Volumes mensais
  avgAdmissions        Float?        // admissÃµes mÃ©dias/mÃªs
  avgTerminations      Float?        // rescisÃµes mÃ©dias/mÃªs
  avgVacations         Float?        // fÃ©rias mÃ©dias/mÃªs
  folhasProcessadas    Int?          // folhas processadas
  unions               Int?          // quantidade de sindicatos/CCTs
  establishments       Int?          @default(1) // estabelecimentos
  // Perfil da empresa
  systemUsed           String?       // sistema utilizado
  automationLevel      String?       // ALTO | MEDIO | BAIXO | MANUAL
  complexity           String?       // BAIXA | MEDIA | ALTA | MUITO_ALTA
  // GestÃ£o
