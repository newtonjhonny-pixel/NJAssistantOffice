model Training {
  id            String   @id @default(cuid())
  /// TREINAMENTO | AMBIENTACAO
  tipo          String   @default("TREINAMENTO")
  /// COMPLETO | SIMPLIFICADO
  modalidade    String   @default("COMPLETO")
  titulo        String
