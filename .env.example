# ============================================================
# NJ Assistant Office — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais
# NUNCA commite o .env com valores reais
# ============================================================

# ── Banco de Dados ────────────────────────────────────────────────────────────
# Produção: PostgreSQL 16 na VPS (usuário criado pelo 01-db-setup.sql)
DATABASE_URL="postgresql://njassistantoffice_user:SENHA_FORTE_AQUI@localhost:5432/njassistantoffice_prod?schema=public"

# Desenvolvimento local: SQLite (não alterar)
# DATABASE_URL="file:./prisma/dev.db"

# ── Autenticação ──────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET="GERAR_COM_OPENSSL_RAND_BASE64_32"

# URL pública da aplicação
NEXTAUTH_URL="https://assistant.nevion.com.br"

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Sem esta chave o sistema usa modo local (sem IA real)
OPENAI_API_KEY="sk-..."

# ── Microsoft Outlook (OAuth) ─────────────────────────────────────────────────
# Configurar em: portal.azure.com → App Registrations
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_REDIRECT_URI="https://assistant.nevion.com.br/api/auth/outlook/callback"

# ── Google Gmail (OAuth) ──────────────────────────────────────────────────────
# Configurar em: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://assistant.nevion.com.br/api/auth/gmail/callback"
