# ============================================================
# NJ Assistant Office — HOMOLOGAÇÃO (modelo, sem credenciais)
#
# Na VPS o arquivo real é /opt/njsistemas/apps/njassistantoffice-homolog/.env.homolog
# No primeiro deploy, scripts/deploy-homolog.sh gera esse arquivo a partir deste
# modelo, criando POSTGRES_PASSWORD e NEXTAUTH_SECRET com `openssl rand` NA VPS
# (nunca passam pelo GitHub). Depois disso o arquivo nunca é sobrescrito.
#
# NUNCA reutilize credenciais ou chaves de produção aqui.
# ============================================================

# ── Banco PRÓPRIO de homologação (container njassistantoffice-homolog-db) ──
POSTGRES_USER=njassistantoffice_hml
POSTGRES_PASSWORD=__GERAR_SENHA_HOMOLOG__
POSTGRES_DB=njassistantoffice_homolog
DATABASE_URL=postgresql://njassistantoffice_hml:__GERAR_SENHA_HOMOLOG__@njassistantoffice-homolog-db:5432/njassistantoffice_homolog?schema=public

# ── Aplicação ──
NEXTAUTH_SECRET=__GERAR_SECRET_HOMOLOG__
# URL pública da homologação (preenchida pelo deploy a partir da variável
# NJAO_HOMOLOG_URL do GitHub).
NEXTAUTH_URL=__URL_HOMOLOG__

# ── Integrações (vazias = desativadas em homologação) ──
OPENAI_API_KEY=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
