!/public/uploads/tasks/.gitkeep
/public/uploads/central/*
!/public/uploads/central/.gitkeep
/public/uploads/importacoes/*
!/public/uploads/importacoes/.gitkeep
/public/uploads/procedures/*
!/public/uploads/procedures/.gitkeep

